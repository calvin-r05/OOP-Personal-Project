<Window x:Class="Project1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Loaded="Window_Loaded"
        Background="DimGray"
         Style="{StaticResource MaterialDesignWindow}">
    <Grid>
        <Grid.RowDefinitions>
            
            <RowDefinition Height="0.1*"/>
            <RowDefinition Height="0.1*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.1*">
            </RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        

        <TextBlock Text="Movies" FontSize="22" Grid.Row="1" Grid.Column="0" />
        <ListBox x:Name="lbxMovies" Grid.Row="2" Grid.Column="0" SelectionChanged="lbxMovies_SelectionChanged"/>

        
        <Grid Grid.Row="3" Grid.Column="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.2*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0.2*"/>
        </Grid.ColumnDefinitions>
            <Button x:Name="btnFav" Content="Favorite"  Grid.Column="1"  Click="btnFav_Click"/>
        </Grid>

        <TextBlock Text="Actors" FontSize="22" Grid.Row="1" Grid.Column="1" />
        <ListBox x:Name="lbxActors" Grid.Row="2" Grid.Column="1" />


        <Grid Grid.Row="3" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.2*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnDetails" Content="Show Details"  Grid.Column="1" Click="btnDetails_Click"/>
        </Grid>

        <TextBlock Text="Favorites" FontSize="22" Grid.Row="1" Grid.Column="2" />
        <ListBox x:Name="lbxFavorites" Grid.Row="2" Grid.Column="2" SelectionChanged="lbxFavorites_SelectionChanged"/>


        <Grid Grid.Row="3" Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.2*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnUnfav" Content="Unfavorite"  Grid.Column="1" Click="btnUnfav_Click"/>
        </Grid>

        <TextBox x:Name="tbxSearch" FontSize="20" Text="Search" Grid.Row="0" Grid.Column="0" GotFocus= "tbxSearch_GotFocus" TextChanged="tbxSearch_TextChanged"/>
    </Grid>
</Window>
