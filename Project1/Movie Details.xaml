<Window x:Class="Project1.Movie_Details"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project1"
        mc:Ignorable="d"
        Title="Movie_Details" Height="450" Width="800"
        Background="DimGray"
        Loaded="Window_Loaded">
    <Grid ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.18*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="0.18*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.3*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Border BorderBrush="White" BorderThickness="0.5" Grid.Row="0" Grid.Column="0"/>
        <Border BorderBrush="White" BorderThickness="0.5" Grid.Row="0" Grid.Column="1"/>
        <Border BorderBrush="White" BorderThickness="0.5" Grid.Row="0" Grid.Column="2"/>
        <Border BorderBrush="White" BorderThickness="0.5" Grid.Row="0" Grid.Column="3"/>
        <Border BorderBrush="White" BorderThickness="0.5" Grid.Row="1" Grid.Column="0"/>
        <Border BorderBrush="White" BorderThickness="0.5" Grid.Row="1" Grid.Column="1"/>
        <Border BorderBrush="White" BorderThickness="0.5" Grid.Row="1" Grid.Column="2"/>
        <Border BorderBrush="White" BorderThickness="0.5" Grid.Row="1" Grid.Column="3"/>
        <Border BorderBrush="White" BorderThickness="0.5" Grid.Row="2" Grid.Column="0"/>
        <Border BorderBrush="White" BorderThickness="0.5" Grid.Row="2" Grid.Column="1"/>
        <Border BorderBrush="White" BorderThickness="0.5" Grid.Row="2" Grid.Column="2"/>
        <Border BorderBrush="White" BorderThickness="0.5" Grid.Row="2" Grid.Column="3"/>
        <Border BorderBrush="White" BorderThickness="0.5" Grid.Row="3" Grid.Column="0"/>
        <Border BorderBrush="White" BorderThickness="0.5" Grid.Row="3" Grid.Column="1"/>
        <Border BorderBrush="White" BorderThickness="0.5" Grid.Row="3" Grid.Column="2"/>
        <Border BorderBrush="White" BorderThickness="0.5" Grid.Row="3" Grid.Column="3"/>



        <TextBlock Text="Released:" FontSize="22" Grid.Row="0" Grid.Column="0"/>
        <TextBlock x:Name="tblxReleased" Text="Date" FontSize="22" Grid.Row="0" Grid.Column="1" TextAlignment="Left"/>
        
        <TextBlock Text="Director: " FontSize="22" Grid.Row="0" Grid.Column="2" TextAlignment="Left"/>
        <TextBlock Text="Name" x:Name="tblxDirector" FontSize="22" Grid.Row="0" Grid.Column="2" TextAlignment="Center"/>
        
        <TextBlock Text="Movie: " FontSize="22" Grid.Row="1" Grid.Column="0" TextAlignment="Left"/>
        <TextBlock x:Name="tblxMovie" Text="Movie Name: " FontSize="22" Grid.Row="1" Grid.Column="1" TextAlignment="Left"/>

        <Image x:Name="imgMovie"  Grid.Column="2" Grid.Row="1"/>

        <TextBlock Text="Lead:" FontSize="22" Grid.Row="2" Grid.Column="1"/>
        <TextBlock Text="Name" x:Name="tblxLead" FontSize="22" Grid.Row="2" Grid.Column="1" TextAlignment="Center"/>
        <Image x:Name="imgLead"  Grid.Column="1" Grid.Row="3"/>

        <TextBlock Text="Starring:" FontSize="22" Grid.Row="2" Grid.Column="2"/>
        <TextBlock Text="Name" x:Name="tblxAnt" FontSize="22" Grid.Row="2" Grid.Column="2" TextAlignment="Center"/>
        <Image x:Name="imgAnt"  Grid.Column="2" Grid.Row="3"/>

    </Grid>
</Window>
